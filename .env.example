# ============================================================
# Vilma — Minha Vida · variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local.
# ============================================================

# URL pública do app (usada em redirecionamentos de OAuth e e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Painel > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
# Chave de serviço: SOMENTE no servidor (exclusão de conta e automações agendadas)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- Anthropic (assistente Vilma) — somente servidor ---
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo usado pela Vilma
ANTHROPIC_MODEL=claude-opus-5-5

# --- Google Calendar (OAuth) — somente servidor ---
# Mostra "Continuar com Google" no login (ative o provedor Google no Supabase antes)
NEXT_PUBLIC_GOOGLE_AUTH=
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Chave de 32 bytes em base64 para criptografar tokens do Google no banco
# Gere com: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=

# --- Automações agendadas (Vercel Cron) ---
# Segredo exigido no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=


# --- Web Push (notificações com o app fechado) ---
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo (e-mail ou URL do responsável pelo app)
VAPID_SUBJECT=mailto:contato@seudominio.com.br
